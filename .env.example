# Copy this file to .env after creating your Feishu Base.
# Keep real tokens and credentials out of source control.
FEISHU_BASE_TOKEN=
FEISHU_TABLE_ID=
FEISHU_IDENTITY=bot

# Separate output table for the agent's reminder source.
FEISHU_DIGEST_TABLE_ID=
FEISHU_DIGEST_VIEW_ID=
# Optional full https URL opened by the card's primary button. If blank, the service builds it from base/table/view.
FEISHU_DIGEST_TABLE_URL=

# Base field mapping used by the digest agent.
FEISHU_CONTENT_FIELD=待办
FEISHU_DATE_FIELD=日期
FEISHU_TIME_FIELD=时间
FEISHU_SOURCE_FIELD=来源

# Digest delivery. Choose exactly one recipient type: user or chat.
FEISHU_RECIPIENT_TYPE=user
FEISHU_RECIPIENT_ID=

# DeepSeek analysis. The prompt is a versioned project file you can edit.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_MAX_TOKENS=2400
DIGEST_PROMPT_FILE=prompts/todo_digest_system.md

# Local-only Mock documents created from the current internal records.
# The default URL is only reachable on this Mac; do not expose it publicly without auth.
MOCK_DOCUMENT_DIR=data/mock_documents
MOCK_DOCUMENT_PUBLIC_URL=http://127.0.0.1:8787
AUTO_DIGEST_ENABLED=true
AUTO_DIGEST_POLL_SECONDS=1
AUTO_DIGEST_DEBOUNCE_SECONDS=10
EVENT_LISTENER_ENABLED=true

# Optional. Defaults to ~/Documents/ActionInbox/action_inbox.db.
# ACTION_INBOX_DB_PATH=
